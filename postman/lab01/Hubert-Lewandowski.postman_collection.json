    {
      "name": "Test Results - trzy testy zaliczone",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", () => {\n    pm.response.to.have.status(201);\n});\npm.test(\"Nagłówek Location wskazuje nowy zasób\", () => {\n    pm.expect(pm.response.headers.get(\"Location\")).to.match(/\\/posts\\/\\d+$/);\n});\nconst post = pm.response.json();\npm.test(\"Serwer nadał identyfikator\", () => {\n    pm.expect(post.id).to.be.a(\"number\");\n});\n// Zapisujemy id, żeby w następnym zapytaniu sprawdzić, czy wpis naprawdę istnieje.\npm.collectionVariables.set(\"post_id\", post.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
